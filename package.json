{
  "name": "algorate-mcp",
  "version": "1.0.0",
  "description": "MCP Server for comparing algorithm implementations through empirical benchmarking",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node --test src/tests/*.test.ts",
    "prepare": "npm run build",
    "example:simple": "npm run build && node examples/simple-test.js",
    "example:sorting": "npm run build && node examples/sorting-benchmark.js"
  },
  "keywords": [
    "mcp",
    "benchmark",
    "performance",
    "algorithms"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "typescript": "^5.8.2"
  }
}
